# nhost
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain-here
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Hasura Admin (server-side only — NEVER expose to client)
HASURA_GRAPHQL_ADMIN_SECRET=your-hasura-admin-secret
HASURA_GRAPHQL_ENDPOINT=https://your-subdomain.hasura.your-region.nhost.run/v1/graphql

# LLM — Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Notification (optional — Slack webhook for notify steps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Webhook security (random string — used to validate inbound webhook triggers)
WEBHOOK_SIGNING_SECRET=change-this-to-a-random-secret-string
